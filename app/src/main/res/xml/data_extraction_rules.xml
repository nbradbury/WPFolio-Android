<?xml version="1.0" encoding="utf-8"?>
<!--
    Nothing leaves the device: the settings file holds the WordPress.com access token, and the
    database holds data tied to that account. allowBackup="false" covers cloud backup; these
    rules also cover device-to-device transfer, which allowBackup no longer controls on API 31+.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
